{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Trackfolio: GUI with sample catalog",
      "type": "debugpy",
      "request": "launch",
      "module": "trackfolio.interfaces.gui",
      "args": ["--dev-root", "${workspaceFolder}", "--database", "${workspaceFolder}/data/database.tfo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Trackfolio: set up GUI"
    },
    {
      "name": "Trackfolio: GUI without catalog argument",
      "type": "debugpy",
      "request": "launch",
      "module": "trackfolio.interfaces.gui",
      "args": ["--dev-root", "${workspaceFolder}", "--no-restore"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Trackfolio: set up GUI"
    }
  ]
}
