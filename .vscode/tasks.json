{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Trackfolio: iniciar GUI con la muestra",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "python", "-m", "trackfolio.interfaces.gui", "--database", "${workspaceFolder}/data/trackfolio.sqlite3"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: iniciar GUI",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "python", "-m", "trackfolio.interfaces.gui"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: ejecutar pruebas GUI sin pantalla",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "pytest"],
      "options": { "cwd": "${workspaceFolder}", "env": { "QT_QPA_PLATFORM": "offscreen" } },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Trackfolio: preparar núcleo",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "--python", "3.13.15", "python", "scripts/bootstrap.py", "--core"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: preparar GUI",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-project", "--python", "3.13.15", "python", "scripts/bootstrap.py", "--gui"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: diagnosticar núcleo",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "python", "scripts/doctor.py", "--core"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: diagnosticar GUI",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "python", "scripts/doctor.py", "--gui"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: diagnosticar GUI sin pantalla",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "python", "scripts/doctor.py", "--gui", "--platform", "offscreen"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: analizar código",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "ruff", "check", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: comprobar formato",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "ruff", "format", "--check", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: comprobar tipos",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "mypy"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: ejecutar pruebas",
      "type": "process",
      "command": "uv",
      "args": ["run", "--locked", "--extra", "gui", "pytest"],
      "options": { "cwd": "${workspaceFolder}", "env": { "QT_QPA_PLATFORM": "offscreen" } },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Trackfolio: comprobaciones",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Trackfolio: analizar código",
        "Trackfolio: comprobar formato",
        "Trackfolio: comprobar tipos",
        "Trackfolio: ejecutar pruebas"
      ],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
