{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Trackfolio: start GUI with sample",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "python", "-m", "trackfolio.interfaces.gui", "--dev-root", "${workspaceFolder}", "--database", "${workspaceFolder}/data/database.tfo"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "python", "-m", "trackfolio.interfaces.gui", "--dev-root", "${workspaceFolder}", "--database", "${workspaceFolder}/data/database.tfo"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: start GUI",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "python", "-m", "trackfolio.interfaces.gui", "--dev-root", "${workspaceFolder}", "--no-restore"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "python", "-m", "trackfolio.interfaces.gui", "--dev-root", "${workspaceFolder}", "--no-restore"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: run headless GUI tests",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "pytest"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "pytest"]
      },
      "options": { "cwd": "${workspaceFolder}", "env": { "QT_QPA_PLATFORM": "offscreen" } },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Trackfolio: set up core",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--core", "--skip-editor", "--non-interactive"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--core", "--skip-editor", "--non-interactive"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: set up GUI",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--gui", "--skip-editor", "--non-interactive"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--gui", "--skip-editor", "--non-interactive"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: diagnose core",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "python", "scripts/doctor.py", "--core"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "python", "scripts/doctor.py", "--core"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: diagnose GUI",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "python", "scripts/doctor.py", "--gui"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "python", "scripts/doctor.py", "--gui"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: diagnose headless GUI",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "python", "scripts/doctor.py", "--gui", "--platform", "offscreen"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "python", "scripts/doctor.py", "--gui", "--platform", "offscreen"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: lint code",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "ruff", "check", "."],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "ruff", "check", "."]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: check formatting",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "ruff", "format", "--check", "."],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "ruff", "format", "--check", "."]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: check types",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "mypy"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "mypy"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trackfolio: run tests",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh", "--run-uv", "run", "--locked", "--extra", "gui", "pytest"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1", "--run-uv", "run", "--locked", "--extra", "gui", "pytest"]
      },
      "options": { "cwd": "${workspaceFolder}", "env": { "QT_QPA_PLATFORM": "offscreen" } },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Trackfolio: checks",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Trackfolio: lint code",
        "Trackfolio: check formatting",
        "Trackfolio: check types",
        "Trackfolio: run tests"
      ],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
